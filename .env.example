# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection Details → Connection string
# Use the "pooled" connection string for production
DATABASE_URL="postgresql://username:password@ep-xxx-yyy-zzz.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Your deployed URL — no trailing slash (Render auto-sets this via render.yaml)
NEXTAUTH_URL="https://crypto-comply.onrender.com"

# Generate with: openssl rand -base64 32
# Render auto-generates this when using render.yaml (generateValue: true)
NEXTAUTH_SECRET="your-secret-here-minimum-32-characters"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="CryptoComply"
NODE_ENV="production"

# ─── OAuth (optional) ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── AWS S3 (optional — for document uploads) ─────────────────────────────────
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="eu-west-2"
# AWS_S3_BUCKET=""
